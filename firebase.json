{
  "functions": [
    {
      "source": "functions",
      "codebase": "home-rhythm-notifications",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "*.log", "test"]
    }
  ],
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Home Rhythm",
        "supportEmail": "skeyd87@gmail.com",
        "authorizedRedirectUris": ["https://skeyd87-rgb.github.io"]
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "docs",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
